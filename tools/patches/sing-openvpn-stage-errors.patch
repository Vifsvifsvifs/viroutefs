diff --git a/peer_session.go b/peer_session.go
index 534776d..fb4f228 100644
--- a/peer_session.go
+++ b/peer_session.go
@@ -4,0 +5,2 @@ import (
+	"errors"
+	"io"
@@ -115,0 +118,37 @@ func readTLSControlRecord(connection *tls.Conn, deadline time.Time) ([]byte, err
+// TLS is a byte stream: one OpenVPN key-method message may be returned by
+// several Read calls. Accumulate only this bounded handshake message until it
+// is structurally complete. Ordinary control messages keep the existing read
+// path because they have no key-method length structure.
+func readTLSKeyMethodRecord(connection *tls.Conn, deadline time.Time, server bool) ([]byte, error) {
+	err := connection.SetReadDeadline(deadline)
+	if err != nil {
+		return nil, err
+	}
+	const maximumRecordSize = 16384
+	record := make([]byte, 0, 2048)
+	for len(record) < maximumRecordSize {
+		chunk := make([]byte, maximumRecordSize-len(record))
+		readCount, readErr := connection.Read(chunk)
+		if readCount > 0 {
+			record = append(record, chunk[:readCount]...)
+			if isAuthFailedPayload(record) || record[0] != 0 {
+				return record, nil
+			}
+			_, parseErr := parseTLSKeyMethod2Payload(record, server)
+			if parseErr == nil {
+				return record, nil
+			}
+			if !errors.Is(parseErr, io.EOF) && !errors.Is(parseErr, io.ErrUnexpectedEOF) {
+				return record, nil
+			}
+		}
+		if readErr != nil {
+			if len(record) > 0 {
+				return record, nil
+			}
+			return nil, readErr
+		}
+	}
+	return nil, E.New("OpenVPN key-method record exceeds 16384 bytes")
+}
